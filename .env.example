# Local Docker demo only. Replace passwords locally; never commit .env.
DB_PASSWORD=replace-with-a-local-demo-password
DEMO_ADMIN_EMAIL=maram@example.test
DEMO_ADMIN_PASSWORD=replace-with-a-unique-demo-password
# Set a private 32-byte base64 key to enable Docker owner MFA.
# Start-Local provisions its own persistent private key automatically.
ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_VERIFICATION_REQUIRED=false
ACCOUNT_MAIL_MODE=file
ACCOUNT_PUBLIC_URL=http://127.0.0.1:8088
# To connect real SMTP, configure all provider settings and use a verified HTTPS URL.
# ACCOUNT_MAIL_MODE=smtp
# ACCOUNT_VERIFICATION_REQUIRED=true
# ACCOUNT_MAIL_HOST=smtp.your-provider.example
# ACCOUNT_MAIL_PORT=587
# ACCOUNT_MAIL_FROM=accounts@your-domain.example
# ACCOUNT_MAIL_USERNAME=replace-locally
# ACCOUNT_MAIL_PASSWORD=replace-locally

# Trusted reverse-proxy peer regex; never leave empty or use .*
TRUSTED_PROXY_REGEX=(?!)
