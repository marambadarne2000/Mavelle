DB_PASSWORD=replace-with-a-local-demo-password
# Optional explicit demo administrator (set both; never use a real password):
# DEMO_ADMIN_EMAIL=maram@example.test
# DEMO_ADMIN_PASSWORD=replace-with-a-unique-demo-password

# Account mail: production is disabled until explicitly configured. Demo uses private local files.
ACCOUNT_VERIFICATION_REQUIRED=true
ACCOUNT_MAIL_MODE=disabled
ACCOUNT_PUBLIC_URL=https://your-domain.example
# SMTP mode requires all of these; never commit real credentials.
# ACCOUNT_MAIL_HOST=smtp.your-provider.example
# ACCOUNT_MAIL_PORT=587
# ACCOUNT_MAIL_FROM=accounts@your-domain.example
# ACCOUNT_MAIL_USERNAME=replace-locally
# ACCOUNT_MAIL_PASSWORD=replace-locally
